# Copy to terraform.tfvars (gitignored) or pass values via -var / TF_VAR_*.
# Secrets (passwords) should come from CI secrets, never be committed.

project     = "aws-db-migration"
environment = "dev"
aws_region  = "us-east-1"

# Networking
vpc_cidr             = "10.20.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs = ["10.20.11.0/24", "10.20.12.0/24"]

# Database
db_name = "appdb"

# dev/source DB (public — lock to your IPs)
dev_db_allowed_cidrs        = ["203.0.113.4/32"]
source_db_instance_class    = "db.t3.small"
source_db_allocated_storage = 20

# prod/target DB (private)
target_db_instance_class      = "db.t3.small"
target_db_allocated_storage   = 20
target_db_multi_az            = false
target_db_deletion_protection = false

# Bastion (SSM jump host for the private prod DB)
bastion_instance_type = "t3.micro"

# --- Secrets: prefer TF_VAR_* env vars over this file -----------------------
# rds_admin_password = "REQUIRED"  # master password for both RDS instances
# dms_db_password    = "REQUIRED"  # DMS replication user on the source DB

# DMS
dms_replication_instance_class = "dms.t3.medium"
dms_migration_type             = "full-load-and-cdc"
dms_start_task                 = false

# Monitoring
alarm_email = "" # e.g. you@example.com
