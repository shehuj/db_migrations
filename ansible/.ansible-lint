# The role consumes connection/config variables supplied by group_vars (shared
# across the dev and prod tiers), so role-name-prefixed variable names would be
# misleading. Everything else runs at the default production profile.
skip_list:
  - var-naming[no-role-prefix]

# Installed Galaxy collections (community.mysql) land here in CI; they are
# third-party vendored code and must not be linted as if they were ours.
exclude_paths:
  - collections/
